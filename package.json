{
  "name": "dsh-image-viewer",
  "version": "0.1.0-beta.7",
  "description": "Zoom, pan, download, gallery, and region-note image viewer for DeepSeek Harness",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "image-viewer",
    "lightbox",
    "zoom",
    "annotation"
  ],
  "author": "WSL043",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/*.map",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "compatibility.json",
    "AGENTS.md",
    "LICENSE",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.mjs",
    "test:behavior": "node --test tests/viewer.test.mjs",
    "test:delivery": "node --test tests/package-contract.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "pnpm run test && pnpm run build && pnpm pack --pack-destination .artifacts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WSL043/dsh-image-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/WSL043/dsh-image-viewer/issues"
  },
  "homepage": "https://github.com/WSL043/dsh-image-viewer#readme",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1 || 4.0.2",
    "@deepseek-ai/dsh-client-locale": "0.1.1-rc.2 || 0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.1-rc.2 || 0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.1-rc.2 || 0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2 || 0.1.2-alpha.2",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-client-locale": { "optional": true },
    "@deepseek-ai/dsh-client-ui-layout": { "optional": true },
    "@deepseek-ai/dsh-client-ui-primitives": { "optional": true },
    "@deepseek-ai/dsh-client-ui-slots": { "optional": true },
    "react": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-client-locale": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "react": "18.3.1",
    "tsdown": "0.22.2"
  }
}
